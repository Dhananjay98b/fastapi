DATABASE_URL = "sqlite:///./users.db"
engine = create_engine(DATABASE_URL,echo =True)

@asynccontextmanager
async def lifespan(app:FastAPI)
    SQLModel.metadata.create_all(engine)
    yield

app = FastAPI(lifespan=lifespan)

def get_session():
    with Session(engine) as session:
        yield session

SessionDep = Annotated[Session,Depends(get_session)]

#Auth 
pwd_context = CryptContext(schemes=["bcrypt",deprecated ="auto"])

def hash_password(password:str)->str:
    return pwd_context.hash(password)

def verify_password(plain:str, hashed:str) ->bool:
    return pwd.context.verify(plain,hashed)

@app.post('register')
def register(session:SessionDep ,user_data:create_user):
    if session.exec(select(User).where(User.email == user.data.email).first()):
        raise HTTPException(status = "400", message = "details are alredy found")

    hash_pwd = hash_password(user_data.password)

    user= User(email = user.data.email, name = user_data.name, hashed_password=hash_pwd)
    session.add(user)
    session.commit()
    session.refresh(user)

    return user

@app.post('/login')
def log_in(session: SessionDep, login_user:loginuser):
    user= exec(select(User).where(User.email == user.data.email).first())
    pwd =verify_password(login_user.password , user.hashe_password)

    if not user or not pwd:
        raise HTTPException(status = "404",deatils = "invalid credintails" )
    return user

